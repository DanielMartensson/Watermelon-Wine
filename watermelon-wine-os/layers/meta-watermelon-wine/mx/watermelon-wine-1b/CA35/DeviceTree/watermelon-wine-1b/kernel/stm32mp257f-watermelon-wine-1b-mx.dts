/ {
	model = "STMicroelectronics STM32MP257F-DK STM32CubeMX board - openstlinux-6.6-yocto-scarthgap-mpu-v26.02.18";
	compatible = "st,stm32mp257f-watermelon-wine-1b-mx", "st,stm32mp257f-dk", "st,stm32mp257";

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>;

		/* USER CODE BEGIN memory */
		/* USER CODE END memory */
	};

	/* USER CODE BEGIN root */

	aliases{
		serial0 = &usart6;
	};

	chosen{
		stdout-path = "serial0:115200n8";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
	};

	hdmi:connector{
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "d";
		hdmi-pwr-supply = <&scmi_v5v_hdmi>;

		port{

			hdmi_connector_in:endpoint{
				remote-endpoint = <&adv7535_out>;
			};
		};
	};

	sound {
		compatible = "audio-graph-card";
		label = "STM32MP25-DK";
		dais = <&i2s2_port>;
		status = "okay";
	};

	/* USER CODE END root */

	clocks{

		/* USER CODE BEGIN clocks */

		clk_ext_camera:clk-ext-camera{
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <24000000>;
		};

		clk_ext_cec:clk-ext-cec{
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <24000000>;
		};
		/* USER CODE END clocks */
	};

}; /*root*/

