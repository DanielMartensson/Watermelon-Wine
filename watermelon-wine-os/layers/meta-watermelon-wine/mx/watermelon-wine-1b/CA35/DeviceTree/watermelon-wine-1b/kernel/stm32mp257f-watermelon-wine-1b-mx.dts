	i3c3_pins_mx: i3c3_mx-0 {
		pins {
			pinmux = <STM32_PINMUX('G', 1, AF3)>, /* I3C3_SCL */
					 <STM32_PINMUX('G', 2, AF3)>; /* I3C3_SDA */
